# --- Database ---
DATABASE_URL=sqlite:///./project21.db

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=document_chunks
QDRANT_VECTOR_SIZE=312

# --- MinIO (S3) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=documents
S3_USE_SSL=false

# --- LLM Provider ---
LLM_PROVIDER=gigachat

# --- GigaChat ---
GIGACHAT_CLIENT_ID=019f86ba-01c1-731d-a81b-39708bf5d002
GIGACHAT_CLIENT_SECRET=9469e115-aa15-4a1a-8024-00796cde4e89
GIGACHAT_CREDENTIALS=MDE5Zjg2YmEtMDFjMS03MzFkLWE4MWItMzk3MDhiZjVkMDAyOjk0NjllMTE1LWFhMTUtNGExYS04MDI0LTAwNzk2Y2RlNGU4OQ==
# GIGACHAT_CREDENTIALS aka GIGACHAT_ACCESS_TOKEN 
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# --- Embedding ---
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# --- Security ---
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- ACL ---
# ACL_DEFAULT_DENY=true

# --- Storage ---
LOCAL_STORAGE_PATH=./storage

EMB_MODEL = sergeyzh/rubert-tiny-turbo #
QDRANT_COLLECTION_NAME=document_chunks #


CHUNK_MODEL = sergeyzh/rubert-tiny-turbo #
CHUNK_THRESHOLD = 80 #

BUFFER_SIZE = 10


AGENT_TEMPERATURE = 0.1 #
AGENT_MAX_TOKEN = 8192 #

# HyDe Setting
HYDE_TEMPERATURE = 0.8 #
HYDE_MAX_TOKEN = 4096 #
MAX_CHUNK_HYDE = 100 #
LIMIT_RRF = 20 #
NUM_RESULTS = 20 #
TOP_RERANKED = 5 #
CROSS_ENC = DiTy/cross-encoder-russian-msmarco #